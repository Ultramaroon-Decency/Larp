# ===========================================================================
# Application Settings
# ===========================================================================
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# Rules:
#   - Lines starting with # are comments (ignored).
#   - Real OS environment variables ALWAYS override values in this file.
#   - Required variables have no fallback — the app won't start without them.
# ===========================================================================

# ── Application ────────────────────────────────────────────────────────────
APP_NAME="Research Agent API"
APP_VERSION="0.1.0"
DEBUG=True
# Allowed values: development | staging | production | testing
ENVIRONMENT="development"

# ── Database ───────────────────────────────────────────────────────────────
# Must use the async driver: postgresql+asyncpg://
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/researchdb"
DATABASE_ECHO=False
# Connection pool settings
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=True

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"

# ── JWT / Authentication ───────────────────────────────────────────────────
# IMPORTANT: Change this in production! Minimum 16 characters.
JWT_SECRET_KEY="super-secret-key-change-me"
# Allowed: HS256, HS384, HS512, RS256, RS384, RS512, ES256
JWT_ALGORITHM="HS256"
# Token lifetime in minutes (default: 1440 = 24 hours, max: 43200 = 30 days)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ───────────────────────────────────────────────────────────────────
# JSON array or comma-separated origins
CORS_ORIGINS='["http://localhost", "http://localhost:3000", "http://localhost:8080"]'

# ── Logging ────────────────────────────────────────────────────────────────
# Allowed: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# ── Rate Limiting ──────────────────────────────────────────────────────────
# Sliding window: max requests per IP within the window
RATE_LIMIT_REQUESTS=100
# Window size in seconds (default: 60 = 1 minute)
RATE_LIMIT_WINDOW_SECONDS=60

# ── Compression ────────────────────────────────────────────────────────────
# Minimum response body size (bytes) before GZip kicks in
GZIP_MINIMUM_SIZE=500
