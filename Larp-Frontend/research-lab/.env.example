# GEMINI_API_KEY: Required for Gemini AI API calls (all 5 pipeline steps).
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# ==============================================================================
# Algorand Testnet & x402 Payment Protocol Configuration
# ==============================================================================
# ── Algorand Receiver (Merchant) Address ─────────────────────────────────────
# The Algorand Testnet wallet address that receives micropayments
AVM_ADDRESS="YOUR_ALGORAND_TESTNET_RECEIVER_ADDRESS"

# ── Autonomous Agent Signing Wallet ──────────────────────────────────────────
# 25-word mnemonic or base64 secret key for the agent to sign payments autonomously
# (If omitted, system falls back to simulation mode with testnet-formatted addresses)
ALGORAND_AGENT_MNEMONIC=""

# ── x402 Facilitator (GoPlausible Testnet) ───────────────────────────────────
FACILITATOR_URL="https://facilitator.goplausible.xyz"

# ── Algorand Testnet RPC & Indexer Nodes ─────────────────────────────────────
ALGOD_SERVER="https://testnet-api.algonode.cloud"
ALGOD_PORT=""
ALGOD_TOKEN=""
INDEXER_SERVER="https://testnet-idx.algonode.cloud"
INDEXER_PORT=""
INDEXER_TOKEN=""

# ── Algorand Network & Asset Identifiers ─────────────────────────────────────
ALGORAND_NETWORK="testnet"
ALGORAND_CAIP2="algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI="
USDC_TESTNET_ASA_ID="10458941"

# ─── Optional External Search APIs ────────────────────────────────────────────
# These are optional. If not set, the pipeline uses Gemini Google Search grounding.
# BRAVE_SEARCH_API_KEY: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=""

# ─── Google OAuth (Frontend) ──────────────────────────────────────────────────
# Required for "Continue with Google" sign-in button.
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID="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"
