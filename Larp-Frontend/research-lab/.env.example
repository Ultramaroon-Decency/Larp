# GEMINI_API_KEY: Required for Gemini AI API calls (all 5 pipeline steps).
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# ─── x402 Payment Layer ────────────────────────────────────────────────────────
# AGENT_WALLET_PRIVATE_KEY: Optional. EVM private key (0x...) for the agent wallet.
# Used to sign real USDC micropayments on Base Sepolia for x402-protected APIs.
# If NOT set, the system runs in SIMULATION MODE — full x402 protocol flow is
# demonstrated with logged transactions but no real on-chain settlement.
# Get a testnet wallet at: https://www.coinbase.com/developer-platform
AGENT_WALLET_PRIVATE_KEY=""

# x402 Facilitator URL (Coinbase-hosted, used for on-chain payment verification).
# Leave as-is for Base Sepolia testnet.
X402_FACILITATOR_URL="https://facilitator.x402.org"

# ─── Optional External Search APIs ────────────────────────────────────────────
# These are optional. If not set, the pipeline uses Gemini Google Search grounding.
# BRAVE_SEARCH_API_KEY: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=""

# ─── Google OAuth (Frontend) ──────────────────────────────────────────────────
# Required for "Continue with Google" sign-in button.
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID="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"
